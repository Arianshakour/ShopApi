{
  "ConnectionStrings": {
    "ShopContext": "Data Source= . ; Initial Catalog= ShopApi ; Integrated Security=true ; TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "ElasticSearch": {
    "Url": "https://localhost:9200",
    "Username": "elastic",
    "Password": "123456",
    "DefaultIndex": "products"
  },
  "Logging": { // pishfarz khode .net core hast
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information", //level Tanzim kard
    "Enrich": [
      "FromLogContext"
    ], //inja baraye dadan TraceId hast be request ha
    "WriteTo": [
      {
        "Name": "Console", //to Console ham namayesh bede
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/shop-.log", //raft too root barname zakhire kone
          "rollingInterval": "Day", //besoorat roozane
          "retainedFileCountLimit": 30, //hadeaksar 30 file negah dar baqie hazf beshan 
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "LoggingSettings": {
    "SlowRequestThresholdMs": 2000 //tanzim time baraye api haye kond ba middleware SlowRequestMiddleware
  },
  "Authentication": {
    "SecretForKey": "thisisthesecretforgeneratingakey(mustbeatleast32bitlong)",
    "Issuer": "http://localhost:5263",
    "Audience": "shopapi"
  },
  "AllowedHosts": "*"
}
